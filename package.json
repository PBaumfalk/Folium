{
  "name": "folium",
  "version": "0.1.1",
  "description": "Folium – selbst gehostete Linkseiten mit Entwurf, Versionen und Design aus der Homepage",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "tsx src/server/cli.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-query": "^5.107.1",
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "htmlparser2": "^10.1.0",
    "nanoid": "^5.1.16",
    "openid-client": "^6.9.0",
    "pino": "^10.4.0",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "undici": "^7.30.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PBaumfalk/Folium.git"
  }
}
