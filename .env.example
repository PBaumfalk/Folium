# ─────────────────────────────────────────────────────────────────────────────
# Folium – Konfiguration. Kopieren nach .env und anpassen. Alle Werte: docs/handbuch/15-konfiguration.md
# Diese Datei NICHT mit echten Schlüsseln einchecken (.env steht in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Adresse der Verwaltungsoberfläche, so wie sie im Browser aufgerufen wird (für Anmeldung und Schutz vor Fremdanfragen)
APP_URL=https://folium.intranet.example.de

# Öffentliche Adresse der Linkseiten (eigener Host, nicht der von Filum)
PUBLIC_BASE_URL=https://links.example.com

# Hinter einem Reverse Proxy: dessen Adresse oder Netz (empfohlen), sonst leer lassen
# TRUST_PROXY=172.18.0.0/16

# Optional: Einrichtungscode selbst festlegen (sonst zufällig, steht im Protokoll)
# SETUP_CODE=

# ── KI für „Design aus Homepage übernehmen“ ─────────────────────────────────
# Ohne Schlüssel bleibt der manuelle Design-Editor voll nutzbar.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=30
# AI_HOURLY_PER_USER=10
# AI_MONTHLY_BUDGET_EUR=20

# Browser für Bildschirmfotos (Dienst folium-browser). Leer setzen, um ohne Bildschirmfotos zu analysieren.
# BROWSER_WS_URL=ws://folium-browser:3000/

# ── Verbindungen ─────────────────────────────────────────────────────────────
# Filum (Kurzlinks): API-Token mit Schreibrecht aus Filum → Einstellungen → API-Tokens
# FILUM_URL=https://filum.intranet.example.de
# FILUM_TOKEN=
# Tessera (QR-Codes): API-Token aus Tessera → Konto → Tokens
# TESSERA_URL=https://qr.intranet.example.de
# TESSERA_TOKEN=

# ── Anmeldung über authentik (OIDC), optional ───────────────────────────────
# OIDC_ISSUER=https://auth.example.de/application/o/folium/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUPS=folium-admins
# OIDC_EDITOR_GROUPS=folium-redaktion
# OIDC_DEFAULT_ROLE=viewer

# ── Sicherungen ──────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Ports auf dem Docker-Host (127.0.0.1 = nur für einen Reverse Proxy auf demselben Server)
PUBLIC_BIND=127.0.0.1
PUBLIC_HOST_PORT=8080
ADMIN_BIND=127.0.0.1
ADMIN_HOST_PORT=8081
